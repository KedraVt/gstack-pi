{
  "name": "@kedra/gstack-pi",
  "version": "1.0.0",
  "description": "gstack browser + workflow skills for pi",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "files": [
    "index.ts",
    "tools.generated.ts",
    "lib/",
    "skills/"
  ],
  "pi": {
